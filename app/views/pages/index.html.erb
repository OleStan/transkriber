<div class="border border-gray-300 p-5">
  <%= form_with(model: @transcription, class: "flex flex-col") do |form| %>
    <p class="text-lg font-bold mb-2">Audio Form</p>
    <div class="flex flex-col mb-4">
      <%= form.label :audio, class: "font-medium mb-2 text-gray-700" %>
      <%= form.file_field :audio, class: "border border-gray-400 p-2 rounded-md" %>
    </div>
    <div class="flex justify-end">
      <%= form.submit "Upload", class: "bg-green-500 text-white px-4 py-2 rounded-md hover:bg-green-600 transition-colors duration-300 ease-in-out" %>
    </div>
  <% end %>
</div>
