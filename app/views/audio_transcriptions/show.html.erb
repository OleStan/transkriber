<div data-controller="clipboard">
  <%= render "audio_transcriptions/audio_player" %>

  <%= button_tag "Copy", data: { action: "click->clipboard#copy" },
                 class: "w-full font-semibold bg-black text-white py-4 rounded-md shadow-md hover:bg-gray-900 transition-colors duration-300 ease-in-out mt-4" %>

  <div id="result_div" data-turbo-frame="show" class="mt-4">
    <%= render partial: "audio_transcriptions/result", locals: { result: @transcription.result } %>
  </div>

  <%= button_to @transcription.result.present? ? "Retranscribe" : "Transcribe",
                transcribe_audio_transcription_path(@transcription.id),
                class: "w-full font-semibold bg-green-500 text-white py-4 rounded-md shadow-md hover:bg-green-600 transition-colors duration-300 ease-in-out mt-20",
                data: { controller: "transcription",
                        action: @transcription.result.present? ? "click->transcription#confirm" : "",
                        'transcription-target': "submitTranscribe",
                        confirm: "Are you sure you want to retranscribe?"
                }
                %>
</div>
