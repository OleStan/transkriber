OPENAI_ACCESS_TOKEN: ""
OPENAI_ORGANIZATION_ID: ""

# Google OAuth credentials
GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""

# Host for audio URL generation (used in serializers)
HOST: "http://localhost:3000"

# Transcription provider: 'openai' or 'google' (default: openai)
TRANSCRIPTION_PROVIDER: "openai"

# Google Cloud credentials (required when TRANSCRIPTION_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS: ""
GOOGLE_CLOUD_PROJECT_ID: ""